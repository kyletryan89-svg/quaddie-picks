# Public Supabase project coordinates (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Group passcode — SERVER ONLY. Checked in a server action against process.env.
# Never prefix this with NEXT_PUBLIC_.
GROUP_PASSCODE=

# Server-only. Used by the seed/security-test scripts AND by the cron ingestion
# routes (lib/supabase/service.ts), which have no user session. Never exposed to
# the client; never referenced from a user-facing action.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only shared secret guarding /api/cron/*. Vercel calls these on a
# schedule; the routes reject any request without `Authorization: Bearer <this>`.
CRON_SECRET=
