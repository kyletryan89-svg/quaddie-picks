# Public Supabase project coordinates (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Group passcode — SERVER ONLY. Checked in a server action against process.env.
# Never prefix this with NEXT_PUBLIC_.
GROUP_PASSCODE=

# Server-only. Used exclusively by scripts/seed.ts and scripts/security-tests cleanup.
# Never exposed to the client; never referenced from app code paths reachable by a request.
SUPABASE_SERVICE_ROLE_KEY=
